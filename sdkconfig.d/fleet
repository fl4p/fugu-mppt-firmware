# fry/flat production image: options of the live build plus the BLE telemetry stream (no adv broadcast: the browser cannot read it).
# Build: idf.py -B build/fleet -DSDKCONFIG=build/fleet/sdkconfig -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.d/fleet" build
CONFIG_FUGU_INA226_MEASURED_RATE=y
CONFIG_FUGU_RT_ALLOC_COUNT=y
CONFIG_FUGU_WITH_ADS=y
CONFIG_FUGU_WITH_BLE=y
CONFIG_FUGU_WITH_FTP=y
CONFIG_FUGU_WITH_HA=y
CONFIG_FUGU_WITH_INA226=y
CONFIG_FUGU_WITH_LEDC=y
CONFIG_FUGU_WITH_MEASURE_COIL=y
CONFIG_FUGU_WITH_MCPWM=y
CONFIG_FUGU_WITH_NETW=y
CONFIG_FUGU_WITH_PSU=y
CONFIG_FUGU_WITH_SCOPE=y
CONFIG_FUGU_WITH_WSYNC=y
CONFIG_FUGU_WITH_BLE_TELE=y
# lwIP API calls off the tcpip thread abort (a wrong-thread call is a heap-corruption race)
CONFIG_LWIP_CHECK_THREAD_SAFETY=y
CONFIG_FUGU_PBUF_PROBE=y
