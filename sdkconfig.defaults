CONFIG_FREERTOS_HZ=1000

# Smaller newlib printf/scanf (no 64-bit ints, no C99 %hh/%ll). ~40 KB flash.
# Format strings audited for %hh/%ll — narrow to 32-bit before re-introducing.
CONFIG_LIBC_NEWLIB_NANO_FORMAT=y

CONFIG_AUTOSTART_ARDUINO=y

CONFIG_ARDUINO_RUNNING_CORE=0
CONFIG_ARDUINO_RUN_CORE0=y
CONFIG_ARDUINO_EVENT_RUNNING_CORE=0
CONFIG_ARDUINO_EVENT_RUN_CORE0=y
CONFIG_ARDUINO_SERIAL_EVENT_TASK_RUNNING_CORE=0
CONFIG_ARDUINO_SERIAL_EVENT_RUN_CORE0=y
CONFIG_ARDUINO_UDP_RUNNING_CORE=0
CONFIG_ARDUINO_UDP_RUN_CORE0=y

# The IDF default-loop task (sys_evt) dispatches WiFi/IP events incl. arduino's _eventCallback.
# Our esp_log hook (vprintf_mux) emits on the caller's stack with a 300 B buffer + mirror, which
# overflows the 2304 B default during a WiFi-reconnect storm and corrupts esp_event's handler-list
# walk (LoadProhibited in esp_event_loop_run). Give it headroom.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

CONFIG_MQTT_TASK_CORE_SELECTION_ENABLED=y
CONFIG_MQTT_USE_CORE_0=y


CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Crash dumps to the `coredump` flash partition (ELF). Survives the panic-reboot so a backtrace can
# be pulled after the fact (incl. unattended/field crashes like the AP-loss reboot, no serial needed).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECK_BOOT=y
CONFIG_ESP_COREDUMP_STACK_SIZE=2304
# Store the full 64-char ELF SHA string in the dump (default 9). esp-coredump gates its full
# register/stack decode on this string matching the ELF's; a 9-char truncation never equals the
# 64-char ELF SHA, so the gate skips and you drop to an addr2line-only backtrace. ~55 B RAM.
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=64


# CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_EXCEPTIONS_EMG_POOL_SIZE=1024



# TODO reset on wd !
# NO! dont disable WD as it is usefull to discover spinlocks (IDLE tasks needed for OS housekeeping)
CONFIG_ESP_TASK_WDT_EN=y


# OTA: (NetworkClientSecure)
# this will significantly increase image size:
CONFIG_MBEDTLS_PSK_MODES=n #y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=n #y

# WiFi: drop SoftAP (we're always STA — never act as AP).
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
# Home APs are WPA2-Personal. Drop WPA3-SAE/SAE-PK/H2E/OWE — saves ~10 KB.
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ENABLE_SAE_PK=n
CONFIG_ESP_WIFI_ENABLE_SAE_H2E=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
# WPA2-Enterprise (EAP-PEAP/TTLS): linked in on IDF 6, ~20 KB
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
# CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT is auto-disabled by SOFTAP_SUPPORT=n.

# mbedTLS prune — we are TLS *client* only (HTTPS-OTA, MQTT). Drop server, RNG-heavy curves,
# CRL/CSR/PEM-write, PKCS7, SSL renegotiation, deterministic ECDSA, SHA-512. Saves ~30–50 KB.
CONFIG_MBEDTLS_TLS_SERVER=n
CONFIG_MBEDTLS_TLS_SERVER_AND_CLIENT=n
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n
CONFIG_MBEDTLS_SERVER_SSL_SESSION_TICKETS=n
CONFIG_MBEDTLS_PKCS7_C=n
CONFIG_MBEDTLS_SHA512_C=n
CONFIG_MBEDTLS_ECDSA_DETERMINISTIC=n
CONFIG_MBEDTLS_PEM_WRITE_C=n
CONFIG_MBEDTLS_X509_CRL_PARSE_C=n
CONFIG_MBEDTLS_X509_CSR_PARSE_C=n
CONFIG_MBEDTLS_PK_PARSE_EC_EXTENDED=n
CONFIG_MBEDTLS_PK_PARSE_EC_COMPRESSED=n
# Curves: keep SECP256R1 (most common for letsencrypt etc), drop the rest.
CONFIG_MBEDTLS_ECP_DP_SECP192R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP192K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=n
# Key exchanges: keep ECDHE_{RSA,ECDSA} and plain RSA. Drop ECDH static and ECDH_RSA.
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA=n
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDH_RSA=n
CONFIG_MBEDTLS_GCM_SUPPORT_NON_AES_CIPHER=n
# IDF 6 (mbedtls 4) options that default on
CONFIG_MBEDTLS_SELF_TEST=n
CONFIG_MBEDTLS_HARDWARE_RSA_DS_PERIPHERAL=n
CONFIG_MBEDTLS_X509_TRUSTED_CERT_CALLBACK=n
CONFIG_MBEDTLS_X509_RSASSA_PSS_SUPPORT=n
CONFIG_MBEDTLS_SSL_ALL_ALERT_MESSAGES=n
CONFIG_MBEDTLS_SSL_CACHE_C=n
CONFIG_MBEDTLS_CIPHER_MODE_CFB=n
CONFIG_MBEDTLS_CIPHER_MODE_OFB=n
CONFIG_MBEDTLS_CIPHER_MODE_XTS=n

# OTA
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# Use the custom partitions.csv (set above), NOT the built-in two-OTA table. Leaving TWO_OTA=y here
# conflicts with CONFIG_PARTITION_TABLE_CUSTOM and a freshly generated sdkconfig resolves the choice
# to TWO_OTA, dropping the `littlefs` partition (build then fails creating the littlefs image).
# CONFIG_PARTITION_TABLE_TWO_OTA is not set
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y # insecure
# App rollback: a freshly-OTA'd image boots as PENDING_VERIFY and MUST be confirmed via
# esp_ota_mark_app_valid_cancel_rollback() (see main.cpp lfMarkOtaValid), else the bootloader reverts
# to the previous slot on the next reset. Pairs with the setup() boot watchdog so a hung image reverts.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# esp-bootguard crash counter (retained RTC record, CRC-covered); required by its bootloader.
CONFIG_BOOTLOADER_CUSTOM_RESERVE_RTC=y
CONFIG_BOOTLOADER_CUSTOM_RESERVE_RTC_SIZE=0x8
CONFIG_BOOTLOADER_CUSTOM_RESERVE_RTC_IN_CRC=y

## Certificate bundle configuration
#CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
#CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y
#CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH="server_certs/ca_cert.pem"

# https://github.com/espressif/esp-idf/blob/v5.2.5/examples/system/ota/simple_ota_example/main/simple_ota_example.c


### perf
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# `rt-stats` console command (print_real_time_stats in src/etc/perf.h): per-task CPU usage.
# Needs the trace facility (enlarges TCBs) + the run-time-stats counter (esp_timer-based, core 0).
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASH_MODE_AUTO_DETECT=n

# https://docs.espressif.com/projects/esp-idf/en/stable/esp32h2/api-guides/performance/speed.html#speed-targeted-optimizations
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY=0x0

# Drop IPv6: nothing in firmware uses AF_INET6 / getaddrinfo on v6; saves ~20 KB flash.
CONFIG_LWIP_IPV6=n

# Drop PPP: only used for cellular/dial-up modems over UART; we only do IP over WiFi.
# arduino-esp32 pulls in esp_modem, whose ESP_MODEM_USE_PPP_MODE `select`s LWIP_PPP_SUPPORT.
# Flip both off here so esp_modem stops forcing PPP on.
CONFIG_ESP_MODEM_USE_PPP_MODE=n
CONFIG_LWIP_PPP_SUPPORT=n
CONFIG_MDNS_TASK_AFFINITY_CPU0=y
CONFIG_MDNS_TASK_AFFINITY=0x0
CONFIG_PTHREAD_DEFAULT_CORE_NO_AFFINITY=0x0

# esp_timer ISR on CPU0 (away from RT_CORE=1). Nothing in this firmware uses ESP_TIMER_ISR
# dispatch, so the ISR's only job is timer-wheel bookkeeping + IPC to the task on CPU0;
# putting it on RT_CORE just added periodic preemption to the ADC/MPPT/PWM hot path.
# Re-enable CPU1 affinity here if a future safety callback needs ESP_TIMER_ISR dispatch.
CONFIG_ESP_TIMER_SHOW_EXPERIMENTAL=y
CONFIG_ESP_TIMER_ISR_AFFINITY_CPU0=y
CONFIG_ESP_TIMER_TASK_AFFINITY_CPU0=y


# PSRAM
#CONFIG_SPIRAM=y
#CONFIG_SPIRAM_USE_MALLOC=y
#CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# --- TEMP DIAGNOSTIC: catch the WiFi-NVS heap-handle corruptor (fry panic 2026-05-29) ---
# fry crashed in wifi_nvs_compare_cfg_diff->nvs_get_u8 because the WiFi NVS handle object's
# vtable pointer was overwritten with a stack/interrupt return address (_xt_lowint1) — memory
# corruption, not bad flash. Comprehensive heap poisoning fills + canary-guards every block and
# aborts (with a backtrace) on the next heap op touching one whose canary/fill was clobbered —
# catching the writer whether it's a stack-overflow-into-heap or a use-after-free.
# Remove once root-caused (adds per-malloc/free overhead). (ESP_SYSTEM_HW_STACK_GUARD would be a
# nice complement but its SOC_ASSIST_DEBUG_SUPPORTED dep resolves false in this build.)
CONFIG_HEAP_POISONING_COMPREHENSIVE=y


CONFIG_ADC_CONTINUOUS_ISR_IRAM_SAFE=y
# CONFIG_ADC_ONESHOT_CTRL_FUNC_IN_IRAM=y


# disable speech recognigtion code
CONFIG_USE_WAKENET=n
CONFIG_USE_MULTINET=n


CONFIG_ARDUHAL_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_ARDUHAL_LOG_DEFAULT_LEVEL=2


# fix for ` undefined reference to `__wrap_esp_log_write'`:
CONFIG_DIAG_USE_EXTERNAL_LOG_WRAP=y


# Target is selected by IDF_TARGET env var (idf-export.sh) or `idf.py set-target`. Don't pin it
# here — a pin in this fragment fights `set-target esp32` (esp32 builds then see the bootloader
# subproject's sdkconfig race and fail with a target mismatch).

# Surfaced by `idf.py save-defconfig` as non-default — a RainMaker default pulled in transitively via
# arduino-esp32 (we don't use RainMaker). Captured here so a regenerated sdkconfig is reproducible.
CONFIG_ESP_RMAKER_ASSISTED_CLAIM=y

# arduino-esp32 selective compilation: only build the libraries we actually use. WiFi/Network/SPI/
# Wire/Update/HTTPClient/FS/SD/SPIFFS/LittleFS/AsyncUDP/DNSServer/ESPmDNS/NetworkClientSecure stay
# on; everything else off. The disabled libraries' source .cpp files are then dropped, which lets
# us EXCLUDE_COMPONENTS the corresponding managed deps (esp_rainmaker, esp_insights, esp_modem,
# esp-sr, esp-zigbee-lib, etc.) in the top-level CMakeLists without breaking compilation.
CONFIG_ARDUINO_SELECTIVE_COMPILATION=y
CONFIG_ARDUINO_SELECTIVE_SPI=y
CONFIG_ARDUINO_SELECTIVE_Wire=y
CONFIG_ARDUINO_SELECTIVE_ESP_SR=n
CONFIG_ARDUINO_SELECTIVE_EEPROM=n
CONFIG_ARDUINO_SELECTIVE_Preferences=y
CONFIG_ARDUINO_SELECTIVE_Ticker=n
CONFIG_ARDUINO_SELECTIVE_Update=y
CONFIG_ARDUINO_SELECTIVE_Zigbee=n
CONFIG_ARDUINO_SELECTIVE_FS=y
CONFIG_ARDUINO_SELECTIVE_SD=n
CONFIG_ARDUINO_SELECTIVE_SD_MMC=n
CONFIG_ARDUINO_SELECTIVE_SPIFFS=n
CONFIG_ARDUINO_SELECTIVE_LittleFS=y
CONFIG_ARDUINO_SELECTIVE_FFat=n
CONFIG_ARDUINO_SELECTIVE_Network=y
CONFIG_ARDUINO_SELECTIVE_Ethernet=n
CONFIG_ARDUINO_SELECTIVE_PPP=n
CONFIG_ARDUINO_SELECTIVE_Hash=y
CONFIG_ARDUINO_SELECTIVE_ArduinoOTA=n
CONFIG_ARDUINO_SELECTIVE_AsyncUDP=y
CONFIG_ARDUINO_SELECTIVE_DNSServer=y
CONFIG_ARDUINO_SELECTIVE_ESPmDNS=y
CONFIG_ARDUINO_SELECTIVE_HTTPClient=y
CONFIG_ARDUINO_SELECTIVE_Matter=n
CONFIG_ARDUINO_SELECTIVE_NetBIOS=n
CONFIG_ARDUINO_SELECTIVE_WebServer=n
CONFIG_ARDUINO_SELECTIVE_WiFi=y
CONFIG_ARDUINO_SELECTIVE_NetworkClientSecure=y
CONFIG_ARDUINO_SELECTIVE_WiFiProv=n
CONFIG_ARDUINO_SELECTIVE_BLE=y  # console_ble.cpp uses BLEDevice (arduino-esp32 BLE wrapper).
CONFIG_ARDUINO_SELECTIVE_BluetoothSerial=n
CONFIG_ARDUINO_SELECTIVE_SimpleBLE=n
CONFIG_ARDUINO_SELECTIVE_RainMaker=n
CONFIG_ARDUINO_SELECTIVE_OpenThread=n
CONFIG_ARDUINO_SELECTIVE_Insights=n
# MCPWM gate driver on by default: fleet (fry/flat) runs pwm_driver=mcpwm, and a regenerated
# sdkconfig with MCPWM=n silently prunes FUGU_WITH_BSYNC (deps) — build succeeds without it.
CONFIG_FUGU_WITH_MCPWM=y
# wired sync compiled in by default; inert unless converter.conf::sync_role != none
CONFIG_FUGU_WITH_WSYNC=y

# IDF 6 made default warnings errors again (5.5 defaulted to y); arduino-esp32 includes IDF LL headers from C++
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y

# --- image-size safe set (doc/image-size-reduction.md) ---
# The MBEDTLS_TLS_SERVER_AND_CLIENT=n line above does not pick another choice member; this does.
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
# mqtt:// only; the websocket transports are dead code.
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET_SECURE=n
# only STA + queryHost/addService are used
CONFIG_MDNS_ENABLE_CONSOLE_CLI=n
CONFIG_MDNS_PREDEF_NETIF_AP=n
CONFIG_MDNS_PREDEF_NETIF_ETH=n
CONFIG_MDNS_ENABLE_BROWSE=n
# PMS memory protection (hardening only). IDF 6 name / IDF 5.5 name.
CONFIG_ESP_SYSTEM_MEMPROT=n
CONFIG_ESP_SYSTEM_MEMPROT_FEATURE=n
# assert() still aborts (backtrace + coredump), just without the file/line/expr string
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
