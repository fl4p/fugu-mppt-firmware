menu "Fugu MPPT firmware"

# Build-time feature flags. These replace the old WITH_* env-var build flags; the CMake build
# reads CONFIG_FUGU_WITH_* and re-emits the matching WITH_* compile define + selects the source
# files / sdkconfig fragments. Toggle with `idf.py menuconfig` or an sdkconfig(.defaults) fragment.

menu "ADC drivers"

    config FUGU_WITH_INA226
        bool "INA226 ADC driver"
        default y
        help
            Compile the INA226 backend (sensor.conf `*_adc=ina226`) with its init self-test.

    config FUGU_INA226_MEASURED_RATE
        bool "INA226: report measured conversion rate (not nominal)"
        default y
        depends on FUGU_WITH_INA226
        help
            ADC_INA226::getSamplingRate() normally returns the nominal rate derived from the
            configured conversion time (1e6 / (2*conv_time_us)). Some INA226 chips (notably
            counterfeit parts) convert faster than their datasheet timing, so the nominal rate
            underestimates the real sample rate — which mistunes anything keyed to it (the
            inverter-ripple notch's reported frequency). The loop-rate watchdog threshold
            always uses the nominal rate.
            When set, getSamplingRate() instead returns a rate measured over several conversions
            at operational settings during init, so it reflects the chip's actual throughput.
            No-op on boards without an INA226 (the measurement lives in ADC_INA226). Default on.

    config FUGU_GPIO_ISR_IRAM
        bool "GPIO ISR service in IRAM (ADC alerts live during caches-off flash writes)"
        default n
        depends on IDF_TARGET_ESP32S3
        help
            Installs the GPIO ISR service with ESP_INTR_FLAG_IRAM, so the INA226/ADS alert ISRs (and
            the ina22x_ov gate trip) keep running while a flash write disables the cache. Only
            effective where rt_iram_extra.lf places the arduino dispatcher in IRAM (not with
            FUGU_RT_FLASH). Not yet tested on the caches-off path.

    config FUGU_WITH_ADS
        bool "ADS1015/ADS1115 ADC driver"
        default y
        help
            Compile the ADS1x15 backend (sensor.conf `*_adc=ads1015|ads1115`) with its init self-test.

endmenu # ADC drivers

menu "PWM drivers"

    choice FUGU_GATE_DRIVER
        prompt "Gate driver"
        default FUGU_GATE_LEDC if IDF_TARGET_ESP32
        default FUGU_WITH_MCPWM
        help
            Half-bridge gate driver, fixed at build time. See website/docs/internals/pwm-drivers.md.

        config FUGU_GATE_LEDC
            bool "LEDC"
            select FUGU_WITH_LEDC
            help
                LEDC timer pair; software dead-time. Default on the classic ESP32.

        config FUGU_WITH_MCPWM
            bool "MCPWM"
            help
                Hardware dead-time, OST fault brake, glitch-free comparator updates, runtime
                `pwm-freq`/`dt`. Needed by wired sync and bsync.

        config FUGU_WITH_VCONV
            bool "Virtual converter plant (simulation, no hardware)"
            help
                Software converter plant (src/sim/vconv.*) in place of gate driver and ADC
                (sensor.conf adc=vconv). Drives no gates.
    endchoice

    config FUGU_WITH_WSYNC
        bool "Wired inter-chip MCPWM clock sync"
        default n
        depends on FUGU_WITH_MCPWM
        help
            Hardware sync of the MCPWM switching clock between converters over an AC-coupled
            wire: a leader emits a TEZ-locked pulse (converter.conf::sync_role=leader), followers
            phase-reload their timer on its edge (sync_role=follower). Pin: board.conf::pwm_sync_pin.
            See website/docs/internals/sync/wired-sync.md.

    config FUGU_WITH_BSYNC
        bool "Beacon-sniffing MCPWM clock sync (bsync service)"
        default n
        depends on FUGU_WITH_NETW && FUGU_WITH_MCPWM
        help
            Phase/frequency-lock the MCPWM switching clock of multiple converters to a shared
            timebase recovered from sniffed 802.11 beacons (RX-only, works unassociated).
            Adds the `bsync` service + bsync.conf. See website/docs/internals/sync/beacon-sync.md.

    config FUGU_WITH_LEDC
        bool "LEDC fan PWM + anaw"
        default y
        help
            LEDC peripheral for the fan PWM (src/cooling.h) and the `anaw` console command. Off
            strips libesp_driver_ledc.a + esp32-hal-ledc (~7 KB). The LEDC gate driver selects it.

endmenu # PWM drivers

config FUGU_WITH_NETW
    bool "Networking (WiFi / mDNS / MQTT / telemetry / HTTPS-OTA)"
    default y
    help
        Compile the WiFi/mDNS/MQTT/telemetry/HTTPS-OTA path. When off, the firmware runs the
        UART/USB/BLE consoles only and the linker garbage-collects wifi/lwip/mbedtls/esp-tls.

if FUGU_WITH_NETW

config FUGU_WITH_HTTPS
    bool "TLS client (https:// OTA and curl, mqtts:// broker)"
    default n
    select ESP_HTTP_CLIENT_ENABLE_HTTPS
    select MQTT_TRANSPORT_SSL
    select MBEDTLS_CERTIFICATE_BUNDLE
    help
        TLS for the HTTP client and MQTT, servers verified against the mbedTLS CA bundle.
        Off, only http:// and mqtt:// URLs work.

config FUGU_WITH_NETTOOLS
    bool "Network debug tools (curl / ping console commands)"
    default n
    help
        Compile the `curl <url>` (blocking HTTP GET, prints the body) and `ping <host>`
        console commands. Debug tools — they reuse the WiFi/HTTP/lwip stack already linked by
        NETW. https:// URLs need FUGU_WITH_HTTPS.

config FUGU_WITH_TELNET
    bool "Telnet console (telnet service, TCP port 23, no authentication)"
    default y
    help
        Plaintext console and log sink on TCP port 23. Anyone on the network can run any
        command. The service starts only with telnet.conf enabled=1.

config FUGU_WITH_TLS_CONSOLE
    bool "TLS-PSK console (tlscon service)"
    default n
    select MBEDTLS_PSK_MODES
    select MBEDTLS_KEY_EXCHANGE_PSK
    help
        Console over TLS 1.2 with a pre-shared key (tlscon.conf psk_id, psk). Turns on the mbedTLS
        server role (sdkconfig.d/tls_console).

config FUGU_WITH_SCOPE
    bool "ADC scope streamer (scope service, TCP port 24)"
    default y
    help
        Stream raw ADC samples over TCP for noise debugging (host client: etc/scope.py).
        Off drops the scope service and compiles every sampling-path hook to nothing.

config FUGU_WITH_FTP
    bool "FTP server for /littlefs (ftp service)"
    default y
    help
        FTP server (2 sessions, passive and active mode) exposing the littlefs partition
        while Wi-Fi is up.

config FUGU_WITH_HTTP_CONF
    bool "HTTP file endpoint for /littlefs/conf (http service)"
    default n
    help
        GET/PUT/DELETE /conf/<name> with HTTP Basic auth (FTP credentials), polled from the
        network loop without its own task. Port and enable flag in http.conf.

config FUGU_WITH_HA
    bool "Home Assistant MQTT discovery"
    default y
    help
        Publish Home Assistant discovery and power state on the MQTT broker.

config FUGU_WITH_TELE_MQTT
    bool "MQTT telemetry sink (tele-mqtt lease)"
    default n
    select FUGU_WITH_TELE_BINARY
    help
        MQTT telemetry sink: `tele-mqtt <s>` leases a binary telemetry stream on pv/tele/<host>
        (uncompressed sym_line_protocol frames). Off by default; a relay republishing the UDP wire
        covers the fleet.

endif # FUGU_WITH_NETW

config FUGU_WITH_BLE
    bool "BLE NUS console + OTA (NimBLE)"
    default y
    select BT_ENABLED
    help
        NimBLE console + OTA push. Adds ~250 KB flash. The NimBLE host selection and radio/thermal
        tunings that Kconfig can't default from here live in sdkconfig.d/ble, layered by CMakeLists
        when this is on.

config FUGU_WITH_BLE_TELE
    bool "BLE telemetry stream (binary wire over NUS notify)"
    default n
    depends on FUGU_WITH_BLE
    select FUGU_WITH_TELE_BINARY
    help
        Stream InfluxDB points (binary sym_line_protocol, tamp-compressed) over a NUS notify
        characteristic — telemetry without WiFi. Host side: etc/influx_binary_proxy.py --ble
        (BLE→InfluxDB bridge) or etc/fugu_console.py --tele. Enable on the device with the
        `set-time` + `tele-ble 1` console commands.

config FUGU_WITH_TELE_BINARY
    bool "Binary telemetry wire (symbol table + tamp)"
    default n
    depends on FUGU_WITH_NETW || FUGU_WITH_BLE_TELE
    help
        Compiles the binary sym_line_protocol wire and the tamp compressor, chosen at runtime by
        tele.conf binary=1. Without it the UDP wire is text only. Selected by FUGU_WITH_BLE_TELE.

config FUGU_WITH_BLE_ADV
    bool "BLE telemetry broadcast (advertising data)"
    default n
    depends on FUGU_WITH_BLE
    help
        Connectionless telemetry: a packed snapshot record in the advertisement's
        manufacturer data, readable by any number of passive observers without connecting
        (the NUS link is exclusive with MAX_CONNECTIONS=1). Keeps broadcasting while a
        client is connected (non-connectable adv). tele.conf::adv_ms sets the refresh
        interval (0 = off). Host side: etc/influx_binary_proxy.py --adv.

config FUGU_WITH_IMPROV
    bool "Improv Wi-Fi provisioning over BLE"
    default y
    depends on FUGU_WITH_BLE && FUGU_WITH_NETW
    help
        Improv Wi-Fi GATT service next to the NUS console: a phone (improv-wifi.com, Home
        Assistant) sends Wi-Fi credentials while the device is offline. Same write security as
        the console (ble.conf ble_security).

config FUGU_WITH_USB_MSC
    bool "USB config drive + CDC console (TinyUSB)"
    default n
    help
        ESP32-S3 only, excludes FUGU_WITH_WSYNC (checked in main/CMakeLists.txt: no `depends on`,
        the idf_component.yml rule needs the symbol to exist in every build). The S3 enumerates as a composite USB device: a CDC console and a FAT drive showing
        /littlefs/conf. Host edits are validated and written back on eject. Takes the USB PHY
        from USB-Serial-JTAG (no USB JTAG; flashing resets into the ROM download mode via the
        CDC port). sdkconfig.d/usb_msc is layered by CMakeLists when this is on.

config FUGU_WITH_SPROFILER
    bool "Semihosting sampling profiler"
    default n
    help
        Compile the semihosting sampling profiler (only useful with OpenOCD attached). When off the
        whole esp32-semihosting-profiler component is excluded (flash + ~8 KB .bss).

config FUGU_WITH_RTPROF
    bool "Core-1 call-stack sampler (rtprof command)"
    default n
    help
        Debug build: a 2 kHz timer ISR on core 1 counts the flash-resident return addresses of the
        interrupted stack; `rtprof` dumps them, `rtprof clear` resets, `rtprof all` resets and counts
        IRAM/ROM addresses too. Map with etc/rtprof_map.py.

config FUGU_RTPROF_SLOTS
    int "rtprof table slots (power of two, 8 bytes each)"
    depends on FUGU_WITH_RTPROF
    range 64 16384
    default 4096

config FUGU_RT_ALLOC_COUNT
    bool "Count heap allocations of the RT task"
    default y if IDF_TARGET_ESP32S3
    select HEAP_USE_HOOKS
    help
        Counts mallocs and frees made by the loopRt task (heap hooks; one call and a task compare per
        heap operation). `rt-stats` and `bootinfo` print the counts; steady state must be zero.

config FUGU_RT_ALLOC_TRACE
    bool "Record call stacks of RT-task heap allocations"
    depends on FUGU_RT_ALLOC_COUNT
    default n
    help
        Also keeps a short backtrace of the first 8 distinct RT-task heap allocation or free sites
        (fixed table, ~350 bytes). Resolve the printed addresses with addr2line against the ELF.

config FUGU_WITH_MEASURE_COIL
    bool "On-device coil inductance measurement"
    default n
    help
        Compile the on-device coil L0/Ls sweep + `measure-coil` console command. It drives the
        half-bridge with test pulses and refuses to start unless conversion was stopped with `dc 0`.
        On in the fleet build (sdkconfig.d/fleet).

config FUGU_WITH_SCRIPTS
    bool "On-device console scripts (run, sleep, scripts, script-set)"
    default n
    help
        Stored console command sequences under /littlefs/scripts/.

config FUGU_WITH_PSU
    bool "PSU / PV-simulator output modes (psu, pv commands)"
    default y
    help
        Constant-voltage PSU mode and the PV-curve simulator: `psu`/`pv` console commands and
        converter.conf mode=psu|pv. Off, a board configured for either mode refuses to start.

config FUGU_WITH_PWR_KNOBS
    bool "Runtime power knobs (pwr command, experiment tool)"
    default n
    help
        `pwr` console command: CPU frequency, PM/DFS/light sleep (with PM_ENABLE), WiFi power save,
        listen interval and TX power, BLE advertising interval, telemetry point interval, die
        temperature. Changes are not persisted; a reboot restores the defaults. sdkconfig.d/pwr
        enables it, sdkconfig.d/pm adds power management with auto light sleep.

endmenu
