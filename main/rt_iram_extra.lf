# RT-loop code rtprof_map.py cannot place by itself: interrupt handlers and code inside critical
# sections (rtprof samples tasks with interrupts on), assembly objects. Found with the IRAM->flash
# call edges of the linked ELF

[mapping:rt_extra_arduino]
archive: libespressif__arduino-esp32.a
entries:
    esp32-hal-gpio:__onPinInterrupt (noflash)
    esp32-hal-misc:millis (noflash)
    Wire:_ZTV7TwoWire (noflash)

[mapping:rt_extra_dsp]
archive: libespressif__esp-dsp.a
entries:
    dsps_biquad_f32_ae32 (noflash)

[mapping:rt_extra_gcc]
archive: libgcc.a
entries:
    _sqrtf (noflash)

# short per-iteration helpers the sampler rarely catches, and the vtables the loop dispatches through
[mapping:rt_extra_main]
archive: libmain.a
entries:
    main:_ZN8AsyncADCIfE6isGoodEv (noflash)
    main:_ZTV15Esp32TempSensor (noflash)
    main:_ZTV18TempSensorGPIO_NTC (noflash)
    main:_ZTV10PD_Control (noflash)
    main:_ZTV25PD_Control_SmoothSetpoint (noflash)
    sensor_setup:_ZTV10ADC_INA226 (noflash)
    adc_esp32_cont:_ZTV14ADC_ESP32_Cont (noflash)
    adc_esp32_cont:_ZN14ADC_ESP32_Cont8inlDeltaEf (noflash)

[mapping:rt_extra_system]
archive: libesp_system.a
entries:
    task_wdt_impl_timergroup:esp_task_wdt_impl_timer_feed (noflash)

[mapping:rt_extra_hal_i2c]
archive: libesp_hal_i2c.a
entries:
    i2c_hal:i2c_hal_master_set_scl_timeout_val (noflash)
    i2c_hal:_i2c_hal_set_bus_timing (noflash)

[mapping:rt_extra_libc]
archive: libc.a
entries:
    libm_math_sf_ceil (noflash)
    libm_common_sf_lround (noflash)
    libm_common_sf_round (noflash)

# esp_log's level check, on the way to the log hook
[mapping:rt_extra_log]
archive: liblog.a
entries:
    log_level:esp_log_is_tag_loggable (noflash)
    log_binary_heap (noflash)
    log_linked_list (noflash)

[mapping:rt_extra_stdcpp]
archive: libstdc++.a
entries:
    new_opnt (noflash)

# shutdown path: a protection trip must not wait for flash
[mapping:rt_extra_shutdown]
archive: libmain.a
entries:
    main:_ZN14MpptController12shutdownDcdcEPKcm (noflash)
    main:_ZN20SynchronousConverter7disableEv (noflash)
    main:_ZN14BackflowDriver6enableEb (noflash)
    main:_Z14stopAndBackoffm (noflash)
    main:_ZN14MpptController10_stopSweepE15MpptControlModeiPNS_3CVPE (noflash)

[mapping:rt_extra_mcpwm]
archive: libesp_driver_mcpwm.a
entries:
    mcpwm_gen:mcpwm_generator_set_force_level (noflash)
