diff --git a/test/test_tracker.cpp b/test/test_tracker.cpp
index daac147f..56384739 100644
--- a/test/test_tracker.cpp
+++ b/test/test_tracker.cpp
@@ -349,3 +349,26 @@ void test_tracker_slow_mode_ends_45s_after_reversal() {
     TEST_ASSERT_FALSE(t.slowMode);
     TEST_ASSERT_TRUE(std::isnan(runTo(t, 100'000))); // no re-entry without a reversal
 }
+
+// pwr_box: the period is whole ripple periods counted on the power sensor's samples, not the clock; the mean starts
+// after the opening sample.
+void test_tracker_box_window() {
+    loopWallClockUs_ = 1'000'000;
+    auto tp = std::make_unique<Tracker>();
+    auto &t = *tp;
+    t.setSlowMode(false);
+    TEST_ASSERT_EQUAL_UINT32(14, t.boxWindow(100.f, 450.f)); // fast: 3 periods of 4.5 samples
+    TEST_ASSERT_EQUAL_UINT32(15, t.boxWindow(120.f, 450.f)); // 4 periods of 3.75
+    t.resetTracker(100.f, /*direction=*/true);
+    t.update(1000.f, 100, 0.f, kSettleMs, 100.f, 450.f, 7); // opens the window, not in the mean
+    for (uint32_t n = 8; n < 7 + 14; ++n) {
+        advanceMs(100); // the clock alone would decide every call
+        t.update(50.f, 100, 0.f, kSettleMs, 100.f, 450.f, n);
+        TEST_ASSERT_TRUE(t._direction);
+    }
+    t.update(50.f, 100, 0.f, kSettleMs, 100.f, 450.f, 7 + 14);
+    TEST_ASSERT_FALSE(t._direction);
+    TEST_ASSERT_EQUAL_FLOAT(50.f, t._curPower);
+    t.setSlowMode(true);
+    TEST_ASSERT_EQUAL_UINT32(225, t.boxWindow(100.f, 450.f)); // 50 periods
+}
